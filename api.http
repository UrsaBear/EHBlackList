@base = http://127.0.0.1:8787
@token = dev-token
@contentType = application/json

# 如果服务端没有设置 API_TOKEN，下面的 Authorization 头会被忽略
### Health
GET {{base}}/health

### Stats
GET {{base}}/stats
Authorization: Bearer {{token}}

### List reasons
GET {{base}}/reasons
Authorization: Bearer {{token}}

### Create ID blacklist entry
POST {{base}}/entries
Authorization: Bearer {{token}}
Content-Type: {{contentType}}

{
  "type": "id",
  "value": "123456",
  "reason_code": "artist",
  "priority": 100
}

### Create keyword blacklist entry
POST {{base}}/entries
Authorization: Bearer {{token}}
Content-Type: {{contentType}}

{
  "type": "keyword",
  "value": "测试关键词",
  "reason_code": "content",
  "priority": 100
}

### Check batch
POST {{base}}/check
Authorization: Bearer {{token}}
Content-Type: {{contentType}}

{
  "items": [
    {"gid": "123456", "title": "任意标题"},
    {"gid": "999999", "title": "这是一个测试关键词标题"},
    {"gid": "888888", "title": "没有命中的标题"}
  ]
}

### List keyword entries
GET {{base}}/entries?type=keyword&limit=50&offset=0
Authorization: Bearer {{token}}

### Update entry by path
PUT {{base}}/entries/keyword/测试关键词
Authorization: Bearer {{token}}
Content-Type: {{contentType}}

{
  "reason_code": "style",
  "priority": 50
}

### Delete entry by value
DELETE {{base}}/entries?type=keyword&value=测试关键词
Authorization: Bearer {{token}}

### Create reason
POST {{base}}/reasons
Authorization: Bearer {{token}}
Content-Type: {{contentType}}

{
  "code": "custom-a",
  "label": "自定义原因",
  "sort_order": 80
}

### Update reason
PUT {{base}}/reasons/custom-a
Authorization: Bearer {{token}}
Content-Type: {{contentType}}

{
  "label": "自定义原因（改名）",
  "sort_order": 80
}

### Delete reason
DELETE {{base}}/reasons/custom-a
Authorization: Bearer {{token}}

### Export
GET {{base}}/export
Authorization: Bearer {{token}}

### Import v2 export file
PUT {{base}}/import?overwrite=false
Authorization: Bearer {{token}}
Content-Type: {{contentType}}

< ./blacklist-export.json

### Import legacy userscript format
PUT {{base}}/import?overwrite=false
Authorization: Bearer {{token}}
Content-Type: {{contentType}}

{
  "ids": ["123456"],
  "keywords": ["测试关键词"]
}
